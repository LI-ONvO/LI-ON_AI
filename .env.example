# 이 파일은 템플릿입니다. 실제 키를 여기에 적지 마세요.
# 복사해서 .env 를 만들고 거기에 값을 채웁니다. (.env 는 .gitignore 대상)
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env

# --- 필수 ---
OPENAI_API_KEY=

# --- 선택 (미설정 시 아래 기본값 사용) ---
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.3
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=2
LOG_LEVEL=INFO

# 모델에 전달할 최근 대화 개수
MAX_HISTORY_MESSAGES=30

# 로드맵 스텝 개수 범위
MIN_ROADMAP_STEPS=3
MAX_ROADMAP_STEPS=8

# --- 자격증 DB (배치가 채워둔 참조 데이터) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# 한 번에 모델에 넘길 자격증 후보 수 / 설명 텍스트 자르는 길이
MAX_CANDIDATES=12
MAX_FIELD_CHARS=400

# --- 배치 전용 (서버 구동에는 불필요) ---
# 공공데이터포털 서비스키. batch/sync_certifications.py 가 사용한다.
DATA_GO_KR_SERVICE_KEY=
